{
  "expo": {
    "name": "PantryChef",
    "slug": "pantrychef",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pantrychef",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ddffe2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pantrychef.app",
      "infoPlist": {
        "NSCameraUsageDescription": "PantryChef uses your camera to scan ingredients in your fridge and pantry.",
        "NSPhotoLibraryUsageDescription": "PantryChef accesses your photos to analyze your pantry items."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ddffe2"
      },
      "package": "com.pantrychef.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PantryChef to access your camera to scan ingredients."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PantryChef to access your photos to analyze pantry items."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ddffe2",
          "image": "./assets/images/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
